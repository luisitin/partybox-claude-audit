+// The smoke gate fails when it plays no game. A zero or non-numeric --runs made every game's shard list empty, and
+// the gate passed with nothing run.
+import { describe, expect, it } from 'vitest';
+import { smoke } from './smoke';
+
+describe('smoke gate', () => {
+  it.each([0, Number.NaN])('--runs %s plays nothing, so the gate fails', async (runs) => {
+    await expect(smoke(runs, 1)).resolves.toBe(false);
+  });
+});
