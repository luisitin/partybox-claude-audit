+/**
+ * A VIP resume moves the deadline on by the pause (the SDK's applyVip). A cpu seat's planned walk is play too, so the
+ * clears still ahead of the pause move on by it: the walk holds through a pause as the clock does.
+ */
+export function holdPlans(before: State, after: State, now: number): State {
+  const shift = pausedFor(before, now);
+  if (shift === 0) return after;
+  const pausedRel = (before.phase.paused?.at ?? now) - before.phase.startedAt;
+  const seats: State['seats'] = {};
+  for (const [id, seat] of Object.entries(after.seats)) {
+    seats[id] = seat.planned
+      ? { ...seat, clears: seat.clears.map((t) => (t > pausedRel ? t + shift : t)) }
+      : seat;
+  }
+  return { ...after, seats };
+}
