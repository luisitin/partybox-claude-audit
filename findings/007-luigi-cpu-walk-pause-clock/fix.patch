@@ -0,0 +1,76 @@
+// The VIP pause holds a cpu seat's planned walk as it holds the deadline (README: "Pause holds the deadline"): the walk
+// is play, so a resume moves its clear times on by the pause, and an End sent while paused settles at the pause.
+import { describe, expect, it } from 'vitest';
+import { testKit } from '@partybox/game-sdk/testing';
+import { game } from '../server/index';
+import { PLAY_MS, ROOM_POINTS, ROOMS } from '../server/types';
+import type { State } from '../server/types';
+
+const T0 = 1_000_000;
+const PLAYERS = [
+  { id: 'a', name: 'Ana', avatarId: 'fox', connected: true },
+  { id: 'b', name: 'Ben', avatarId: 'owl', connected: true },
+  { id: 'cpu', name: 'Luigi Bot', avatarId: 'bee', connected: true, bot: true },
+];
+
+const kit = testKit(game, { t0: T0, inputAt: 1000, players: PLAYERS, settings: {} });
+const at = (t: number): number => T0 + t;
+type Seat = State['seats'][string];
+
+/** The cpu seat plans its walk at 1 s; its last clear is the planned finish, in ms from the phase start. */
+function planned(): { state: State; finish: number } {
+  const state = kit.input(kit.start(), 'cpu', { type: 'cpu' }, at(1_000));
+  const finish = (state.seats.cpu as Seat).clears.at(-1) as number;
+  expect(finish).toBeLessThan(PLAY_MS); // the walk pulls the deadline in
+  return { state, finish };
+}
+
+describe('pause clock: a cpu seat walks through a VIP pause as the deadline does', () => {
+  it("a 30 s pause moves the cpu seat's planned clears and finish on by 30 s", () => {
+    const { state, finish } = planned();
+    const resumed = kit.vip(kit.vip(state, 'pause', at(10_000)), 'resume', at(40_000));
+    expect(resumed.phase.deadline).toBe(at(finish + 30_000));
+    expect((resumed.seats.cpu as Seat).clears.at(-1)).toBe(finish + 30_000);
+  });
+
+  it('a human out 10 s after the cpu plan wins, because the pause held the cpu plan', () => {
+    const { state, finish } = planned();
+    const resumed = kit.vip(kit.vip(state, 'pause', at(10_000)), 'resume', at(40_000));
+    // 'a' clears its last room at finish + 10 s on the wall clock. The cpu's walk is 30 s longer than its plan on the
+    // wall clock after the pause, so the cpu is out at finish + 30 s and 'a' is first.
+    const end = resumed.phase.deadline as number;
+    const humanClears = Array.from({ length: ROOMS }, (_, i) =>
+      Math.round(((i + 1) * (finish + 10_000)) / ROOMS),
+    );
+    const withHuman: State = {
+      ...resumed,
+      seats: {
+        ...resumed.seats,
+        a: {
+          ...(resumed.seats.a as Seat),
+          room: ROOMS,
+          clears: humanClears,
+          left: humanClears.map((t) => Math.min(PLAY_MS, Math.max(0, end - (T0 + t)))),
+        },
+      },
+    };
+    expect(kit.timer(withHuman, end).winner).toBe('a');
+  });
+
+  it("a cpu seat's time left at its last clear is read against the deadline the game ends on", () => {
+    const { state } = planned();
+    const resumed = kit.vip(kit.vip(state, 'pause', at(10_000)), 'resume', at(40_000));
+    // The walk ends exactly at the deadline, so no time is left on its clock: 9 rooms and 0 ms.
+    expect(kit.timer(resumed, resumed.phase.deadline as number).scores.cpu).toBe(
+      ROOMS * ROOM_POINTS,
+    );
+  });
+
+  it('an End sent while paused settles at the pause: the cpu seat gets only the rooms it walked by then', () => {
+    const { state, finish } = planned();
+    const paused = kit.vip(state, 'pause', at(10_000));
+    // The End lands at finish + 5 s, still paused: the walk had only run 10 s of play by the pause.
+    const done = kit.vip(paused, 'end', at(finish + 5_000));
+    expect(done.scores.cpu).toBeLessThan(ROOMS * ROOM_POINTS);
+  });
+});
