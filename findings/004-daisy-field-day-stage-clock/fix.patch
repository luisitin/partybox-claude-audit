@@ -0,0 +1,30 @@
+// A pause holds the deadline (README: "Pause holds the deadline"), so a move is timed on the stage clock: a move after
+// a resume is stored at its stage time, not at the wall time since the stage began.
+import { describe, expect, it } from 'vitest';
+import { testKit } from '@partybox/game-sdk/testing';
+import { game } from '../server/index';
+import { STAGE_MS } from '../server/types';
+import type { State } from '../server/types';
+
+const T0 = 1_000_000;
+const PLAYERS = [
+  { id: 'a', name: 'Ana', avatarId: 'fox', connected: true },
+  { id: 'b', name: 'Ben', avatarId: 'owl', connected: true },
+];
+const kit = testKit(game, { t0: T0, inputAt: 1000, players: PLAYERS, settings: {} });
+
+describe('a pause is not stage time', () => {
+  it('control: a move with no pause is stored at its stage time', () => {
+    const r = kit.input(kit.start(), 'a', { type: 'jump' }, T0 + 17_000);
+    expect(r.moves['a']?.[0]).toMatchObject({ t: 17_000 });
+  });
+
+  it('a move after a 20 s pause is stored at its stage time (37 s on the wall = 17 s in the stage)', () => {
+    const s = kit.start();
+    const paused = kit.vip(s, 'pause', T0 + 5_000);
+    const resumed = kit.vip(paused, 'resume', T0 + 25_000) as State;
+    expect(resumed.phase.deadline).toBe(T0 + STAGE_MS + 20_000);
+    const r = kit.input(resumed, 'a', { type: 'jump' }, T0 + 37_000);
+    expect(r.moves['a']?.[0]).toMatchObject({ t: 17_000 });
+  });
+});
