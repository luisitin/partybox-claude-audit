+++ b/games/spy-grid/__tests__/pause-clock.test.ts
@@ -0,0 +1,27 @@
+// The teams net's 10 min cap is play time: a VIP pause holds the net (README: "Pause holds every clock"), so a pause
+// does not spend the windows the room has left.
+import { expect, it } from 'vitest';
+import { kit, send, start } from './kit';
+import type { State } from '../server/types';
+
+/** Taps once, then runs the net's windows out (a tap before each re-arm); a pause, if any, starts before the first. */
+function windowsUntilClue(pause?: { at: number; ms: number }): number {
+  let s: State = send(start(6), 'p1', { type: 'join', team: 'sun' });
+  const t = s.phase.startedAt;
+  if (pause) s = kit.vip(kit.vip(s, 'pause', t + pause.at), 'resume', t + pause.at + pause.ms);
+  let windows = 0;
+  for (let i = 0; i < 30 && s.phase.id === 'teams'; i++) {
+    s = kit.timer(s, s.phase.deadline as number);
+    windows++;
+    if (s.phase.id === 'teams') s = send(s, 'p1', { type: 'join', team: 'sun' });
+  }
+  return windows;
+}
+
+it('the net gives up after 10 windows of play when nobody pauses', () => {
+  expect(windowsUntilClue()).toBe(10);
+});
+
+it('a 5 min VIP pause does not spend 5 of the 10 windows: the room still gets 10 minutes of play', () => {
+  expect(windowsUntilClue({ at: 10_000, ms: 300_000 })).toBe(10);
+});
