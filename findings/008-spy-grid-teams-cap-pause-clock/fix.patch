 export function enterTeams(state: State, now: number): State {
-  return enterPhase({ ...state, teamsTouched: false }, 'teams', now, TEAMS_MS);
+  return enterPhase({ ...state, teamsTouched: false, teamsPlayed: 0 }, 'teams', now, TEAMS_MS);
 }
 
 function onNet(state: State, now: number, next: Transition): State {
-  const elapsed = now - state.phase.startedAt;
-  if (!state.teamsTouched || elapsed + TEAMS_MS > TEAMS_GIVE_UP_MS) return next(state, now);
+  // Play time, not the wall clock: each window that ran out is a full minute, and a VIP pause holds the net.
+  const played = (state.teamsPlayed ?? 0) + TEAMS_MS;
+  if (!state.teamsTouched || played + TEAMS_MS > TEAMS_GIVE_UP_MS) return next(state, now);
   // Each window needs a tap of its own: one join buys one more minute, not the whole 10.
-  return { ...state, teamsTouched: false, phase: { ...state.phase, deadline: now + TEAMS_MS } };
+  return {
+    ...state,
+    teamsTouched: false,
+    teamsPlayed: played,
+    phase: { ...state.phase, deadline: now + TEAMS_MS },
+  };
 }
 
