+// A pause holds the deadline (README: "Pause holds the deadline"), so the fight's clock must not run through it:
+// a stomp after a resume is timed on the fight clock, not on the wall clock since the phase began.
+import { describe, expect, it } from 'vitest';
+import { testKit } from '@partybox/game-sdk/testing';
+import { game } from '../server/index';
+import type { State } from '../server/types';
+
+const T0 = 1_000_000;
+const PLAYERS = [
+  { id: 'a', name: 'Ana', avatarId: 'fox', connected: true },
+  { id: 'b', name: 'Ben', avatarId: 'owl', connected: true },
+];
+const kit = testKit(game, { t0: T0, inputAt: 1000, players: PLAYERS, settings: {} });
+
+describe('a pause is not fight time', () => {
+  it('control: the same stomp with no pause counts', () => {
+    const s = kit.start();
+    const total = s.settings['seconds'] as number;
+    const r = kit.input(s, 'a', { type: 'stomp', col: 0 }, T0 + total * 1000 - 1_000);
+    expect(r.taps['a']).toBe(1);
+  });
+
+  it('a stomp in the last second of the fight after a pause counts (it is inside the fight)', () => {
+    const s = kit.start();
+    const total = s.settings['seconds'] as number;
+    const paused = kit.vip(s, 'pause', T0 + 5_000);
+    const resumed = kit.vip(paused, 'resume', T0 + 25_000) as State;
+    expect(resumed.phase.deadline).toBe(T0 + total * 1000 + 20_000);
+    // 1 s before the clock runs out: total-1 s into the fight, 20 s more than that since it began.
+    const r = kit.input(resumed, 'a', { type: 'stomp', col: 0 }, T0 + total * 1000 + 19_000);
+    expect(r.taps['a']).toBe(1);
+  });
+});
