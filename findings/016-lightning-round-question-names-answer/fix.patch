diff --git a/games/lightning-round/__tests__/answer-not-in-question.test.ts b/games/lightning-round/__tests__/answer-not-in-question.test.ts
new file mode 100644
index 000000000..3ba6c54b1
--- /dev/null
+++ b/games/lightning-round/__tests__/answer-not-in-question.test.ts
@@ -0,0 +1,36 @@
+// A question must not name its own correct answer: the player reads the question before the reveal, so a question that
+// says "Papua New Guinea" for the answer "New Guinea" gives the answer away. Scans both packs (English and Spanish).
+import { describe, expect, it } from 'vitest';
+import questionsJson from '../content/questions.json' with { type: 'json' };
+import questionsEsJson from '../content/questions.es.json' with { type: 'json' };
+
+// Questions whose answer word is in the text on purpose: a grammar question asks which word of a given sentence is the
+// subject or object, and "una" is both the answer (one) and an article in the question. Open, see FINDING.md.
+const KNOWN = new Set(['gpt-0794', 'gpt-0795', 'gpt-0869', 'gpt-1425', 'lan-0240-es']);
+
+type Item = { id: string; question: string; choices: string[]; answerIndex: number };
+
+const fold = (text: string): string => text.normalize('NFD').replace(/\p{M}/gu, '').toLowerCase();
+
+const namesAnswer = (question: string, answer: string): boolean => {
+  const word = fold(answer.trim());
+  if (word.length < 3) return false;
+  const escaped = word.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
+  return new RegExp(`(?<!\\p{L})${escaped}(?!\\p{L})`, 'u').test(fold(question));
+};
+
+const itemsOf = (json: unknown): Item[] =>
+  (Array.isArray(json) ? json : (json as { items: Item[] }).items) as Item[];
+
+describe('no question names its own answer', () => {
+  it.each([
+    ['questions.json', questionsJson],
+    ['questions.es.json', questionsEsJson],
+  ])('%s', (_name, json) => {
+    const hits = itemsOf(json)
+      .filter((item) => !KNOWN.has(item.id))
+      .filter((item) => namesAnswer(item.question, item.choices[item.answerIndex] ?? ''))
+      .map((item) => `${item.id}: "${item.question}" names "${item.choices[item.answerIndex]}"`);
+    expect(hits).toEqual([]);
+  });
+});
