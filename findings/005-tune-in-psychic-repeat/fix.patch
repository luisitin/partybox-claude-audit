+// Spec: "never the last psychic twice in a row when anyone else can go" (turn.ts drawPsychic). A refill that puts a
+// dropped player first must not hand the last psychic a second turn while a connected player is in the bag.
+import { describe, expect, it } from 'vitest';
+import { seedRng } from '@partybox/game-sdk';
+import { planTurn } from '../server/turn';
+import { link, start } from './helpers';
+
+describe('the psychic does not repeat while someone else can go', () => {
+  it('after a refill, a dropped player at the head of the bag does not give the last psychic a second turn', () => {
+    const base = start(3);
+    const [a, b, c] = base.seats as [string, string, string];
+    const dropped = link(base, c, false);
+    const repeats: number[] = [];
+    for (let seed = 1; seed <= 300; seed++) {
+      const s = {
+        ...dropped,
+        rng: seedRng(seed),
+        turn: { ...dropped.turn, psychic: b },
+        psychicBag: { ...dropped.psychicBag, all: [c], [a]: [], [b]: [], [c]: [] },
+      };
+      if (planTurn(s, false).turn.psychic === b) repeats.push(seed);
+    }
+    expect(repeats).toEqual([]);
+  });
+});
