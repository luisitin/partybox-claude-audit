+// A pause holds the deadline (README: "Pause holds the deadline"), so the machine's clock must not run through it:
+// a tap or an end after a resume is timed on the game clock, not on the wall clock since the phase began.
+import { describe, expect, it } from 'vitest';
+import { testKit } from '@partybox/game-sdk/testing';
+import { game } from '../server/index';
+import { GAME_MS } from '../server/types';
+import type { State } from '../server/types';
+
+const T0 = 1_000_000;
+const PLAYERS = [
+  { id: 'a', name: 'Ana', avatarId: 'fox', connected: true },
+  { id: 'b', name: 'Ben', avatarId: 'owl', connected: true },
+];
+const kit = testKit(game, { t0: T0, inputAt: 1000, players: PLAYERS, settings: {} });
+
+/** Play 10 s, pause for 30 s, resume: 80 s of play is left on the clock and the deadline reads T0 + GAME_MS + 30 s. */
+const resumed = (): State => {
+  const s = kit.start();
+  const paused = kit.vip(s, 'pause', T0 + 10_000);
+  return kit.vip(paused, 'resume', T0 + 40_000) as State;
+};
+
+describe('a pause is not play', () => {
+  it('a tap in the last seconds of the game clock is accepted and timed on the game clock', () => {
+    const r = resumed();
+    expect(r.phase.deadline).toBe(T0 + GAME_MS + 30_000);
+    // 1 s before the clock runs out: 89 s of game time, 119 s since the phase began.
+    const s = kit.input(r, 'a', { type: 'flip', side: 1 }, T0 + 119_000);
+    expect(s.acts['a']).toEqual([{ t: 89_000, v: 1 }]);
+  });
+
+  it('a skip after a resume ends the machine at the game time it reached, not at the wall time', () => {
+    const skipped = kit.vip(resumed(), 'skip', T0 + 119_000) as State;
+    expect(skipped.phase.id).toBe('done');
+    expect(skipped.endMs).toBe(89_000);
+  });
+
+  it('an end sent during a pause settles at the pause, not at the wall time', () => {
+    const paused = kit.vip(kit.start(), 'pause', T0 + 10_000);
+    const ended = kit.vip(paused, 'end', T0 + 40_000) as State;
+    expect(ended.phase.id).toBe('done');
+    expect(ended.endMs).toBe(10_000);
+  });
+});
