+// A pause holds the deadline (README: "Pause holds the deadline"), so a stage's clock must not run through it:
+// a step after a resume is timed on the stage clock, not on the wall clock since the stage began.
+import { describe, expect, it } from 'vitest';
+import { testKit } from '@partybox/game-sdk/testing';
+import { game } from '../server/index';
+import { GIFT_MS } from '../server/types';
+import type { State } from '../server/types';
+
+const T0 = 1_000_000;
+const PLAYERS = [
+  { id: 'a', name: 'Ana', avatarId: 'fox', connected: true },
+  { id: 'b', name: 'Ben', avatarId: 'owl', connected: true },
+];
+const kit = testKit(game, { t0: T0, inputAt: 1000, players: PLAYERS, settings: {} });
+
+describe('a pause is not stage time', () => {
+  it('a step in the last seconds of the stage clock after a pause is accepted at its stage time', () => {
+    const s = kit.start();
+    const paused = kit.vip(s, 'pause', T0 + 5_000);
+    const resumed = kit.vip(paused, 'resume', T0 + 25_000) as State;
+    expect(resumed.phase.id).toBe('gift');
+    expect(resumed.phase.deadline).toBe(T0 + GIFT_MS + 20_000);
+    // 1 s before the clock runs out: 17 s into the stage (37 s since it began, less the 20 s pause).
+    const r = kit.input(resumed, 'a', { type: 'step', dir: 1 }, T0 + 37_000);
+    expect(r.acts['a']).toHaveLength(1);
+    expect(r.acts['a']?.[0]).toMatchObject({ t: 17_000 });
+  });
+
+  it('an end sent during a pause banks the stage at the pause, as if the pause had not happened', () => {
+    const tap = (state: State, now: number): State =>
+      kit.input(state, 'a', { type: 'step', dir: 1 }, now);
+    // no pause: the stage is ended at 5 s into it
+    const ended = kit.vip(tap(kit.start(), T0 + 3_000), 'end', T0 + 5_000) as State;
+    // the same 5 s, then a pause; the End arrives 20 s later, still paused
+    const paused = kit.vip(tap(kit.start(), T0 + 3_000), 'pause', T0 + 5_000);
+    const pausedEnd = kit.vip(paused, 'end', T0 + 25_000) as State;
+    expect(pausedEnd.phase.id).toBe('done');
+    expect(pausedEnd.gained).toEqual(ended.gained);
+  });
+});
