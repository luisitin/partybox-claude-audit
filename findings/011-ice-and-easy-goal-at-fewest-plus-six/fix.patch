+  it('a goal reached on the fewest slides plus six is the loss too, for no points', () => {
+    // Right, left, right, left, right, left, right, then down onto the goal: eight slides, the fewest two plus six.
+    const path = [RIGHT, LEFT, RIGHT, LEFT, RIGHT, LEFT, RIGHT, DOWN];
+    let s = start();
+    let t = T0 + 100;
+    for (const dir of path) s = go(s, 'a', dir, (t += 300));
+    expect(s.world.seats.a).toMatchObject({ n: 1, ok: 0, last: 0, e: true });
+  });
